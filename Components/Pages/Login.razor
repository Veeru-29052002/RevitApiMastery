@page "/login"
@inject AuthService Auth
@inject NavigationManager NavManager
@implements IDisposable

<PageTitle>Portal Sign In | Revit & C# Academy</PageTitle>

<div class="row justify-content-center my-4">
    <div class="col-lg-8 col-xl-7">
        @if (Auth.IsAuthenticated)
        {
            <!-- Logged-in State Card -->
            <div class="cad-card cad-bracket p-5 text-center">
                <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(@(Auth.IsAdmin ? "168, 85, 247, 0.2" : "16, 185, 129, 0.2")); border: 2px solid @(Auth.IsAdmin ? "var(--accent-purple)" : "var(--accent-cyan)");">
                    <i class="bi @(Auth.IsAdmin ? "bi-shield-lock-fill text-purple" : "bi-person-check-fill text-success")" style="font-size: 2.5rem;"></i>
                </div>
                <h2 class="h3 fw-bold text-white mb-1">Currently Signed In</h2>
                <div class="mb-3">
                    <span class="badge @(Auth.IsAdmin ? "bg-purple text-white" : "badge-beginner") px-3 py-2" style="font-size:0.85rem;">
                        <i class="bi @(Auth.IsAdmin ? "bi-shield-check" : "bi-mortarboard") me-1"></i>
                        @(Auth.IsAdmin ? "ACADEMY ADMINISTRATOR" : "STUDENT DEVELOPER")
                    </span>
                </div>
                <h3 class="h4 text-cyan fw-bold mb-1">@Auth.CurrentUser?.FullName</h3>
                <p class="text-secondary small mb-1">@Auth.CurrentUser?.Title &bull; @Auth.CurrentUser?.Organization</p>
                <p class="text-muted small mb-4">Username: <code class="text-white">@Auth.CurrentUser?.Username</code> &bull; Email: <code>@Auth.CurrentUser?.Email</code></p>

                <div class="d-flex flex-wrap justify-content-center gap-3">
                    @if (Auth.IsAdmin)
                    {
                        <a href="admin" class="btn-primary-glow" style="background: linear-gradient(135deg, #7c3aed, #a855f7) !important;">
                            <i class="bi bi-speedometer2 me-1"></i> Admin Command Center
                        </a>
                    }
                    <a href="account" class="btn-outline-glow">
                        <i class="bi bi-person-gear me-1"></i> My Account
                    </a>
                    <a href="syllabus" class="btn-outline-glow">
                        <i class="bi bi-journal-text me-1"></i> View Syllabus
                    </a>
                    <a href="support" class="btn-outline-glow" style="border-color: var(--accent-amber); color: var(--accent-amber);">
                        <i class="bi bi-headset me-1"></i> Support Desk
                    </a>
                    <button class="btn btn-outline-danger btn-sm px-3" @onclick="HandleLogout">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- Dual Login Interface -->
            <div class="cad-card cad-bracket p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom" style="border-color: rgba(0,240,255,0.15) !important;">
                    <span class="cad-drawing-tag">
                        <span>SECURITY PORTAL:</span>
                        <strong>IDENTITY ACCESS MANAGEMENT</strong>
                    </span>
                    <span class="font-monospace text-secondary small d-none d-sm-inline">ENCRYPTED // TLS 1.3</span>
                </div>
                <div class="text-center mb-4">
                    <div class="brand-icon mx-auto mb-2" style="width: 52px; height: 52px; font-size: 1.6rem;">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h1 class="h3 fw-bold text-white mb-1">Academy Access Terminal</h1>
                    <p class="text-secondary small mb-0">Select your security role below to initialize your workstation session</p>
                </div>

                <!-- Tab Selectors -->
                @if (!string.IsNullOrWhiteSpace(ReturnUrl))
                {
                    <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-3" style="background: rgba(0, 240, 255, 0.1); border-color: rgba(0, 240, 255, 0.3); color: var(--accent-cyan);">
                        <i class="bi bi-shield-lock-fill fs-5"></i>
                        <div>
                            <strong>Course Lesson Access:</strong> Please sign in with your enrolled credentials to unlock this course lesson. You will be redirected immediately upon sign-in.
                        </div>
                    </div>
                }

                <div class="d-flex p-1 rounded mb-4" style="background: rgba(0,0,0,0.4); border: 1px solid var(--border-color);">
                    <button class="btn flex-fill py-2 @(activeRoleTab == UserRole.User ? "btn-primary-glow" : "btn-link text-secondary text-decoration-none")" 
                            @onclick="() => SwitchTab(UserRole.User)">
                        <i class="bi bi-person-badge me-1"></i>
                        <span class="fw-bold">User / Student Login</span>
                    </button>
                    <button class="btn flex-fill py-2 @(activeRoleTab == UserRole.Admin ? "btn-primary-glow" : "btn-link text-secondary text-decoration-none")" 
                            style="@(activeRoleTab == UserRole.Admin ? "background: linear-gradient(135deg, #7c3aed, #a855f7) !important;" : "")"
                            @onclick="() => SwitchTab(UserRole.Admin)">
                        <i class="bi bi-shield-lock me-1"></i>
                        <span class="fw-bold">Admin / Instructor Login</span>
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                        <span>@errorMessage</span>
                    </div>
                }

                @if (activeRoleTab == UserRole.User)
                {
                    <!-- USER / STUDENT FORM -->
                    <form @onsubmit="HandleLogin">
                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-bold">Email or Username</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-envelope"></i></span>
                                <input type="text" class="form-control bg-dark border-secondary text-white" 
                                       placeholder="Enter your registered email or username" 
                                       @bind="loginEmail" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label text-secondary small fw-bold mb-0">Password</label>
                                <button type="button" class="btn btn-link text-cyan p-0 text-decoration-none" style="font-size:0.75rem;" @onclick="() => showUserForgotHelp = !showUserForgotHelp">
                                    Forgot password?
                                </button>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-lock"></i></span>
                                <input type="password" class="form-control bg-dark border-secondary text-white" 
                                       placeholder="Enter your account password" 
                                       @bind="loginPassword" required />
                            </div>
                        </div>

                        @if (showUserForgotHelp)
                        {
                            <!-- Student Password Reset Guidance -->
                            <div class="p-3 mb-4 rounded bg-dark border border-info" style="background: rgba(14, 165, 233, 0.08) !important;">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="bi bi-info-circle-fill text-info mt-1"></i>
                                    <div>
                                        <div class="fw-bold text-white small mb-1">Student Account Recovery</div>
                                        <p class="text-secondary small mb-2" style="font-size:0.8rem; line-height:1.4;">
                                            To maintain platform security, student credentials are issued and reset directly by academy administrators. 
                                            Please make a request to the <strong>Support Helpdesk</strong>, and our administrative team will assist you in restoring your account.
                                        </p>
                                        <a href="support" class="btn btn-sm btn-outline-info py-1 px-3" style="font-size:0.75rem;">
                                            <i class="bi bi-headset me-1"></i> Request Password Reset via Support &rarr;
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input bg-dark border-secondary" type="checkbox" id="userRemember" checked />
                                <label class="form-check-label text-secondary small" for="userRemember">Remember this session</label>
                            </div>
                            <span class="text-muted small">Standard Student Access</span>
                        </div>

                        <button type="submit" class="btn-primary-glow w-100 justify-content-center py-2">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Sign In as Student / User</span>
                        </button>
                    </form>
                }
                else
                {
                    <!-- ADMIN / INSTRUCTOR FORM -->
                    @if (showAdminResetForm)
                    {
                        <!-- Admin Password Reset Module -->
                        <div class="p-4 rounded mb-4" style="background: rgba(168, 85, 247, 0.08); border: 1px solid var(--accent-purple);">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-key-fill text-purple fs-4"></i>
                                    <h3 class="h5 fw-bold text-white mb-0">Admin Password Reset</h3>
                                </div>
                                <button type="button" class="btn-close btn-close-white" @onclick="() => showAdminResetForm = false"></button>
                            </div>

                            @if (adminResetTokenSent)
                            {
                                <div class="p-3 mb-3 rounded bg-success bg-opacity-10 border border-success">
                                    <div class="text-success fw-bold small mb-1"><i class="bi bi-send-check-fill me-1"></i>Verification Token Dispatched to Email!</div>
                                    <p class="text-white small mb-0" style="font-size:0.82rem; line-height: 1.4;">
                                        A secure verification code has been dispatched to <strong>@resetEmailInput</strong>. 
                                        Please check your email inbox, copy the single-use token, and paste it below to reset your password.
                                    </p>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label text-secondary small fw-bold">Verification Token (from Email) *</label>
                                    <input type="text" class="form-control font-monospace bg-dark border-secondary text-warning" 
                                           placeholder="Paste code from email (e.g. RST-123456)" 
                                           @bind="tokenInput" required />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label text-secondary small fw-bold">New Admin Password</label>
                                    <input type="password" class="form-control bg-dark border-secondary text-white" 
                                           placeholder="Enter new admin password" 
                                           @bind="newAdminPasswordInput" required />
                                </div>

                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => showAdminResetForm = false">Cancel</button>
                                    <button class="btn btn-sm btn-primary-glow" style="background: linear-gradient(135deg, #7c3aed, #a855f7) !important;" @onclick="HandleAdminResetPasswordSubmit">
                                        Confirm & Update Password
                                    </button>
                                </div>
                            }
                            else
                            {
                                <p class="text-secondary small mb-3">
                                    Enter your registered Administrator email address below. A password reset link and verification code will be sent to your inbox.
                                </p>

                                <div class="mb-3">
                                    <label class="form-label text-secondary small fw-bold">Admin Email Address</label>
                                    <input type="email" class="form-control bg-dark border-secondary text-white" 
                                           placeholder="bveerababu612@gmail.com" 
                                           @bind="resetEmailInput" required />
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <button type="button" class="btn btn-link text-secondary p-0 text-decoration-none small" @onclick="() => showAdminResetForm = false">
                                        Back to Login
                                    </button>
                                    <button type="button" class="btn btn-sm btn-primary-glow" style="background: linear-gradient(135deg, #7c3aed, #a855f7) !important;" @onclick="HandleSendAdminResetLink">
                                        <i class="bi bi-envelope-arrow-up me-1"></i> Send Reset Link
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <form @onsubmit="HandleLogin">
                            <div class="mb-3">
                                <label class="form-label text-secondary small fw-bold">Admin Email or Username</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-shield-lock"></i></span>
                                    <input type="text" class="form-control bg-dark border-secondary text-white" 
                                           placeholder="Enter admin email or username" 
                                           @bind="loginEmail" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label text-secondary small fw-bold mb-0">Admin Security Password</label>
                                    <button type="button" class="btn btn-link text-purple p-0 text-decoration-none" style="font-size:0.75rem;" @onclick="() => showAdminResetForm = true">
                                        Forgot password?
                                    </button>
                                </div>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-key"></i></span>
                                    <input type="password" class="form-control bg-dark border-secondary text-white" 
                                           placeholder="Enter admin password" 
                                           @bind="loginPassword" required />
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input class="form-check-input bg-dark border-secondary" type="checkbox" id="adminRemember" checked />
                                    <label class="form-check-label text-secondary small" for="adminRemember">Restricted Admin Environment</label>
                                </div>
                                <span class="badge bg-danger text-white" style="font-size:0.65rem;">ELEVATED ROLES</span>
                            </div>

                            <button type="submit" class="btn-primary-glow w-100 justify-content-center py-2" style="background: linear-gradient(135deg, #7c3aed, #a855f7) !important;">
                                <i class="bi bi-shield-lock-fill"></i>
                                <span>Sign In to Admin Console</span>
                            </button>
                        </form>
                    }
                }
            </div>
        }
    </div>
</div>

@code {
    private UserRole activeRoleTab = UserRole.User;
    private string loginEmail = "";
    private string loginPassword = "";
    private string? errorMessage;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    // Student Forgot Help
    private bool showUserForgotHelp = false;

    // Admin Reset Flow
    private bool showAdminResetForm = false;
    private string resetEmailInput = "bveerababu612@gmail.com";
    private bool adminResetTokenSent = false;
    private string tokenInput = "";
    private string newAdminPasswordInput = "";

    protected override void OnInitialized()
    {
        Auth.OnAuthStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Auth.OnAuthStateChanged -= StateHasChanged;
    }

    private void SwitchTab(UserRole role)
    {
        activeRoleTab = role;
        errorMessage = null;
        loginEmail = "";
        loginPassword = "";
        showUserForgotHelp = false;
        showAdminResetForm = false;
        adminResetTokenSent = false;
    }

    private void HandleLogin()
    {
        errorMessage = null;
        var (success, error) = Auth.Login(loginEmail, loginPassword, activeRoleTab);
        if (success)
        {
            if (!string.IsNullOrWhiteSpace(ReturnUrl))
            {
                NavManager.NavigateTo(ReturnUrl);
            }
            else if (Auth.IsAdmin)
            {
                NavManager.NavigateTo("admin");
            }
            else
            {
                NavManager.NavigateTo("syllabus");
            }
        }
        else
        {
            errorMessage = error ?? "Invalid credentials. Please verify your credentials.";
        }
    }

    private void HandleSendAdminResetLink()
    {
        errorMessage = null;
        var resetUrl = NavManager.BaseUri.TrimEnd('/') + "/login";
        var (success, error, token) = Auth.RequestAdminPasswordReset(resetEmailInput, resetUrl);
        if (success)
        {
            tokenInput = "";
            adminResetTokenSent = true;
        }
        else
        {
            errorMessage = error ?? "Failed to send reset link.";
        }
    }

    private void HandleAdminResetPasswordSubmit()
    {
        errorMessage = null;
        var (success, error) = Auth.ResetPasswordWithToken(resetEmailInput, tokenInput, newAdminPasswordInput);
        if (success)
        {
            showAdminResetForm = false;
            adminResetTokenSent = false;
            loginEmail = resetEmailInput;
            loginPassword = newAdminPasswordInput;
            errorMessage = null;
            // Notify success
            NavManager.NavigateTo("login");
        }
        else
        {
            errorMessage = error ?? "Failed to reset password.";
        }
    }

    private void HandleLogout()
    {
        Auth.Logout();
    }
}
