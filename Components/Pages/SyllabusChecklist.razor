@page "/syllabus"
@inject CurriculumService Curriculum
@inject ProgressService Progress
@inject AuthService Auth
@inject NavigationManager NavManager
@implements IDisposable

<PageTitle>Official 98-Topic Syllabus Matrix | Revit & C# Academy</PageTitle>

<div class="container-fluid px-0">
    <!-- Header Banner -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4 pb-3" style="border-bottom: 1px solid var(--border-color);">
        <div style="min-width: 0; flex: 1;">
            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                <span class="badge bg-primary px-2 py-1" style="font-size:0.75rem;">OFFICIAL CURRICULUM</span>
                <span class="badge bg-dark text-cyan border border-cyan px-2 py-1" style="font-size:0.75rem;">98 TOPICS COMPLETE</span>
            </div>
            <h1 class="h2 fw-bold text-white mb-1">Curriculum Syllabus & Progress Tracker</h1>
            <p class="text-secondary mb-0" style="font-size: 0.92rem;">
                Complete step-by-step roadmap from <strong class="text-white">C# Stage 1</strong> through <strong class="text-white">C# Stage 2 (Advanced)</strong>, <strong class="text-white">Revit API Stage 3 (Core)</strong>, to <strong class="text-cyan">Revit API Stage 4 (Master WPF & MVVM)</strong>.
            </p>
        </div>

        <!-- Global Summary Pill -->
        <div class="d-flex gap-3 align-items-center bg-dark p-3 rounded border border-secondary flex-shrink-0" style="background: rgba(18, 24, 38, 0.9) !important;">
            <div class="text-center">
                <div class="fs-4 fw-bold text-cyan">@GetCompletedCount() / @totalTopicsCount</div>
                <div class="text-muted" style="font-size: 0.72rem; text-transform: uppercase;">Completed</div>
            </div>
            <div style="width: 1px; height: 36px; background: var(--border-color);"></div>
            <div class="text-center">
                <div class="fs-4 fw-bold text-success">@GetOverallProgressPercentage()%</div>
                <div class="text-muted" style="font-size: 0.72rem; text-transform: uppercase;">Overall Mastery</div>
            </div>
        </div>
    </div>

    @if (!Auth.IsAuthenticated)
    {
        <!-- Guest Preview Alert -->
        <div class="cad-card p-3 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3" style="border-color: rgba(0, 240, 255, 0.3); background: rgba(8, 14, 25, 0.85);">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded p-2 text-warning fs-4" style="background: rgba(245, 158, 11, 0.15);">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div>
                    <div class="fw-bold text-white small">Guest Preview Mode Active</div>
                    <div class="text-secondary small">Course lessons, production C# code samples, and progress tracking require an authenticated session.</div>
                </div>
            </div>
            <a href="login?returnUrl=syllabus" class="btn-primary-glow btn-sm py-2 px-3">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Access Full Course
            </a>
        </div>
    }

    <!-- Track Filter Selector -->
    <div class="d-flex flex-wrap gap-2 mb-3">
        <button class="btn btn-sm @(selectedTrackFilter == "" ? "btn-primary-glow" : "btn-outline-secondary")" @onclick='() => SetTrackFilter("")'>
            <i class="bi bi-collection-fill me-1"></i>All 20 Modules
        </button>
        <button class="btn btn-sm @(selectedTrackFilter == "csharp" ? "btn-primary-glow" : "btn-outline-secondary")" @onclick='() => SetTrackFilter("csharp")'>
            <i class="bi bi-filetype-cs me-1"></i>Track 1: C# Programming (C1 - C10)
        </button>
        <button class="btn btn-sm @(selectedTrackFilter == "revitapi" ? "btn-primary-glow" : "btn-outline-secondary")" @onclick='() => SetTrackFilter("revitapi")'>
            <i class="bi bi-boxes me-1"></i>Track 2: Revit API C# (R1 - R10)
        </button>
    </div>

    <!-- Dynamic Modules Quick Cards Grid -->
    <div class="row g-3 mb-4">
        @foreach (var mod in GetFilteredModules())
        {
            <div class="col-12 col-md-6 col-xl-4 col-xxl-3">
                <div class="card bg-dark border-secondary h-100 @(selectedModuleFilter == mod.Id ? "border-info" : "")" 
                     style="cursor: pointer; background: rgba(15, 23, 42, 0.8) !important; border-left: 3px solid @(mod.TrackId == "csharp" ? "var(--accent-purple)" : "var(--accent-cyan)") !important;" 
                     @onclick='() => SetModuleFilter(mod.Id)'>
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge @(mod.TrackId == "csharp" ? "bg-purple text-white" : "bg-dark text-cyan border border-secondary") fw-bold">@mod.ModuleCode</span>
                            <span class="badge bg-secondary" style="font-size: 0.7rem;">@mod.Topics.Count Topics</span>
                        </div>
                        <h5 class="card-title text-white fw-bold mb-1 text-truncate" title="@mod.Title" style="font-size: 0.92rem;">@mod.Title</h5>
                        <p class="card-text text-secondary mb-3 text-truncate" style="font-size: 0.76rem;" title="@mod.ShortDescription">@mod.ShortDescription</p>
                        <div class="d-flex justify-content-between text-muted mb-1" style="font-size: 0.72rem;">
                            <span>Progress</span>
                            <span class="text-cyan">@GetModuleCompletedCount(mod.Id) / @mod.Topics.Count (@GetModuleProgress(mod.Id)%)</span>
                        </div>
                        <div class="progress" style="height: 5px; background: rgba(255,255,255,0.1);">
                            <div class="progress-bar @(mod.TrackId == "csharp" ? "bg-purple" : "bg-info")" style="width: @(GetModuleProgress(mod.Id))%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Filter & Search Controls -->
    <div class="card bg-dark border-secondary mb-4" style="background: rgba(18, 24, 38, 0.8) !important;">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <!-- Search -->
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control bg-dark border-secondary text-white" 
                                placeholder="Filter syllabus topic..." 
                                @bind="searchFilter" @bind:event="oninput" />
                    </div>
                </div>

                <!-- Module Select Filter -->
                <div class="col-md-3">
                    <select class="form-select form-select-sm bg-dark border-secondary text-white" @bind="selectedModuleFilter">
                        <option value="">All Modules (@totalTopicsCount Topics)</option>
                        @foreach (var mod in Curriculum.GetAllSyllabusModules())
                        {
                            <option value="@mod.Id">@mod.ModuleCode: @mod.Title (@mod.Topics.Count Topics)</option>
                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="col-md-3">
                    <select class="form-select form-select-sm bg-dark border-secondary text-white" @bind="statusFilter">
                        <option value="all">All Statuses (Complete & Incomplete)</option>
                        <option value="completed">Completed Only (YES)</option>
                        <option value="incomplete">Incomplete Only (NO)</option>
                    </select>
                </div>

                <!-- Reset / Batch actions -->
                <div class="col-md-2 text-md-end">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- The Exact Spreadsheet Table View -->
    <div class="card bg-dark border-secondary overflow-hidden shadow-lg" style="background: rgba(13, 17, 23, 0.95) !important;">
        <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center py-2 px-3">
            <div class="fw-bold text-white d-flex align-items-center gap-2">
                <i class="bi bi-table text-cyan"></i>
                <span>Syllabus Spreadsheet View</span>
                <span class="badge bg-secondary" style="font-size:0.75rem;">Showing @GetFilteredTopics().Count() of @totalTopicsCount topics</span>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-xs btn-outline-info py-1 px-2" style="font-size:0.72rem;" @onclick="MarkCurrentFilterAllCompleted">
                    <i class="bi bi-check-all me-1"></i>Mark Filtered as YES
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" style="border-collapse: separate; border-spacing: 0;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border-color); background: rgba(22, 27, 34, 0.9);">
                        <th class="text-center text-secondary" style="width: 50px;">#</th>
                        <th class="text-secondary text-uppercase fw-semibold" style="width: 220px; font-size: 0.8rem;">Module</th>
                        <th class="text-secondary text-uppercase fw-semibold" style="font-size: 0.8rem;">Topic</th>
                        <th class="text-center text-secondary text-uppercase fw-semibold" style="width: 140px; font-size: 0.8rem;">Completed</th>
                        <th class="text-secondary text-uppercase fw-semibold" style="width: 180px; font-size: 0.8rem;">Progress %</th>
                        <th class="text-end text-secondary text-uppercase fw-semibold" style="width: 120px; font-size: 0.8rem;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                        var filteredList = GetFilteredTopics().ToList();
                    }

                    @if (!filteredList.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-search fs-2 mb-2 d-block"></i>
                                No topics match the selected search or filters.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in filteredList)
                        {
                            var isDone = Progress.IsTopicCompleted(item.Topic.Id);
                            var moduleBadgeClass = item.ModuleId switch
                            {
                                "c-lvl1" => "badge bg-info text-dark",
                                "c-adv" => "badge bg-purple text-white",
                                "revit-lvl01" => "badge bg-success text-dark",
                                "revit-master" => "badge bg-warning text-dark",
                                _ => "badge bg-secondary"
                            };

                            var rowClass = isDone ? "table-active-subtle" : "";

                            <tr class="@rowClass" style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                <td class="text-center text-muted" style="font-size: 0.78rem;">@(index++)</td>
                                
                                <!-- Module Column -->
                                <td>
                                    <span class="@moduleBadgeClass fw-semibold px-2 py-1" style="font-size:0.75rem;">
                                        @item.ModuleName
                                    </span>
                                </td>

                                <!-- Topic Column with Link -->
                                <td>
                                    <div class="d-flex flex-column">
                                        <a href="topic/@item.Topic.Id" class="text-decoration-none fw-semibold text-white link-cyan-hover">
                                            @item.Topic.Title
                                        </a>
                                        <span class="text-secondary" style="font-size: 0.78rem;">
                                            @item.Topic.Subtitle
                                        </span>
                                    </div>
                                </td>

                                <!-- Completed (Yes/No) Column -->
                                <td class="text-center">
                                    <button class="btn btn-sm py-1 px-3 fw-bold @(isDone ? "btn-success" : "btn-outline-secondary")"
                                            style="font-size: 0.75rem; min-width: 75px; border-radius: 20px;"
                                            @onclick="() => ToggleTopic(item.Topic.Id)">
                                        @if (isDone)
                                        {
                                            <i class="bi bi-check-lg me-1"></i><span>YES</span>
                                        }
                                        else
                                        {
                                            <span>NO</span>
                                        }
                                    </button>
                                </td>

                                <!-- Progress % Column (10% standard increment or 100% when completed) -->
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; background: rgba(255,255,255,0.08);">
                                            <div class="progress-bar @(isDone ? "bg-success" : "bg-cyan")" 
                                                 style="width: @(isDone ? "100" : "10")%;"></div>
                                        </div>
                                        <span class="fw-bold @(isDone ? "text-success" : "text-secondary")" style="font-size: 0.78rem; min-width: 35px;">
                                            @(isDone ? "100%" : "10%")
                                        </span>
                                    </div>
                                </td>

                                <!-- Action Link -->
                                <td class="text-end">
                                    <a href="topic/@item.Topic.Id" class="btn btn-sm btn-outline-cyan py-1 px-2" style="font-size: 0.75rem;">
                                        <span>Study</span> <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private record SyllabusItem(string ModuleId, string ModuleName, Topic Topic);

    private List<SyllabusItem> allSyllabusItems = new();
    private string searchFilter = string.Empty;
    private string selectedModuleFilter = string.Empty;
    private string selectedTrackFilter = string.Empty;
    private string statusFilter = "all";
    private int totalTopicsCount = 0;

    protected override void OnInitialized()
    {
        Auth.OnAuthStateChanged += StateHasChanged;
        Progress.OnChange += StateHasChanged;
        LoadSyllabus();
    }

    private void LoadSyllabus()
    {
        allSyllabusItems.Clear();

        foreach (var mod in Curriculum.GetAllSyllabusModules())
        {
            foreach (var t in mod.Topics)
            {
                allSyllabusItems.Add(new SyllabusItem(mod.Id, $"{mod.ModuleCode}: {mod.Title}", t));
            }
        }

        totalTopicsCount = allSyllabusItems.Count;
    }

    private IEnumerable<Module> GetFilteredModules()
    {
        var modules = Curriculum.GetAllSyllabusModules();
        if (!string.IsNullOrWhiteSpace(selectedTrackFilter))
        {
            return modules.Where(m => m.TrackId.Equals(selectedTrackFilter, StringComparison.OrdinalIgnoreCase));
        }
        return modules;
    }

    private void SetTrackFilter(string trackId)
    {
        selectedTrackFilter = trackId;
        selectedModuleFilter = string.Empty;
    }

    private IEnumerable<SyllabusItem> GetFilteredTopics()
    {
        var result = allSyllabusItems.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(selectedModuleFilter))
        {
            result = result.Where(i => i.ModuleId.Equals(selectedModuleFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(searchFilter))
        {
            result = result.Where(i => 
                i.Topic.Title.Contains(searchFilter, StringComparison.OrdinalIgnoreCase) ||
                i.Topic.Subtitle.Contains(searchFilter, StringComparison.OrdinalIgnoreCase) ||
                i.ModuleName.Contains(searchFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (statusFilter == "completed")
        {
            result = result.Where(i => Progress.IsTopicCompleted(i.Topic.Id));
        }
        else if (statusFilter == "incomplete")
        {
            result = result.Where(i => !Progress.IsTopicCompleted(i.Topic.Id));
        }

        return result;
    }

    private void SetModuleFilter(string moduleId)
    {
        if (selectedModuleFilter == moduleId)
            selectedModuleFilter = string.Empty;
        else
            selectedModuleFilter = moduleId;
    }

    private void ClearFilters()
    {
        searchFilter = string.Empty;
        selectedModuleFilter = string.Empty;
        statusFilter = "all";
    }

    private void ToggleTopic(string topicId)
    {
        if (!Auth.IsAuthenticated)
        {
            NavManager.NavigateTo($"login?returnUrl=topic/{topicId}");
            return;
        }
        Progress.ToggleTopicCompleted(topicId);
    }

    private void MarkCurrentFilterAllCompleted()
    {
        if (!Auth.IsAuthenticated)
        {
            NavManager.NavigateTo("login?returnUrl=syllabus");
            return;
        }

        foreach (var item in GetFilteredTopics())
        {
            if (!Progress.IsTopicCompleted(item.Topic.Id))
            {
                Progress.ToggleTopicCompleted(item.Topic.Id);
            }
        }
    }

    private int GetCompletedCount()
    {
        return allSyllabusItems.Count(i => Progress.IsTopicCompleted(i.Topic.Id));
    }

    private int GetOverallProgressPercentage()
    {
        if (totalTopicsCount == 0) return 0;
        return (int)Math.Round((double)GetCompletedCount() / totalTopicsCount * 100);
    }

    private int GetModuleCompletedCount(string moduleId)
    {
        return allSyllabusItems.Count(i => i.ModuleId == moduleId && Progress.IsTopicCompleted(i.Topic.Id));
    }

    private int GetModuleProgress(string moduleId)
    {
        var total = allSyllabusItems.Count(i => i.ModuleId == moduleId);
        if (total == 0) return 0;
        var done = GetModuleCompletedCount(moduleId);
        return (int)Math.Round((double)done / total * 100);
    }

    public void Dispose()
    {
        Auth.OnAuthStateChanged -= StateHasChanged;
        Progress.OnChange -= StateHasChanged;
    }
}
